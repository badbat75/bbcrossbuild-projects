## Sets default values:
LFS_SPLITUSR=${LFS_SPLITUSR:-0}
LFS_ENABLESSH=${LFS_ENABLESSH:-1}
LFS_ENABLEDEV=${LFS_ENABLEDEV:-0}
LFS_HOSTNAME=${LFS_HOSTNAME:-lfs}
LFS_FSTYPE=${LFS_FSTYPE:-ext4}
LFS_FSSIZE=${LFS_FSSIZE:-8G}
LFS_WLANDEV=${LFS_WLANDEV:-wlan0}
### DHCP on the wired interface (net.ifnames=0 on the kernel command line names it eth0 on every
### platform); LFS_LANDEV= in lfs.conf leaves it unconfigured
LFS_LANDEV=${LFS_LANDEV-eth0}
### Compressed swap on zram for the boards with little RAM; LFS_ZRAM=0 in lfs.conf leaves the
### unit out of the image (the kernel keeps its zram module)
LFS_ZRAM=${LFS_ZRAM:-1}
### NetworkManager for the wired and the WiFi link instead of systemd-networkd and
### wpa_supplicant@<device>; LFS_ENABLENM=1 in lfs.conf builds and configures it
LFS_ENABLENM=${LFS_ENABLENM:-0}

echo "Tool chain: ${TOOLCHAIN}"
echo "Architecture: ${HARCH}"
echo
echo "Is ssh enabled: $( [ ${LFS_ENABLESSH} -eq 1 ] && echo yes || no )"
echo "Is zram swap enabled: $( [ ${LFS_ZRAM} -eq 1 ] && echo yes || no )"
echo "Network managed by: $( [ ${LFS_ENABLENM} -eq 1 ] && echo NetworkManager || echo systemd-networkd )"
echo "LFS hostname: ${LFS_HOSTNAME}"
echo "LFS filesystem type: ${LFS_FSTYPE}"
if [ -n "${LFS_LANDEV}" ]
then
	echo "LAN device: ${LFS_LANDEV}"
fi
if [ -n "${LFS_WLANSSID}" ] && [ -n "${LFS_WLANPSK}" ] && [ -n "${LFS_WLANDEV}" ]
then
	echo "WLAN device: ${LFS_WLANDEV}"
	echo "SSID: ${LFS_WLANSSID}"
fi
echo

## Enable shared libraries (default) but disable static ones
BUILD_LIBSHARED=1
BUILD_LIBSTATIC=0

## Enable LTO both for kernel and applications
LTOENABLE=thin
KERNEL_LTOENABLE=thin

### Basic filesystem
	build lfs/create-base-fs_1.0
	build lfs/create-base-config_1.0
### Basic toolchain and core libraries
setup_full_toolchain --with-gnu-install --with-main-gcc --with-llvm --with-python
### Kernel core, boot loaders, utilities and firmwares
	case ${PLATFORM_NAME} in
		rpi*)
			WITH_INITRAMFS=1 WITH_KERNEL_FS=${LFS_FSTYPE} build raspberrypi/rpi-kernel_$( echo ${KERNEL_VER} | cut -d'.' -f1,2 )
			build raspberrypi/rpi-firmware_1
			build raspberrypi/rpi-bluez-firmware
			build raspberrypi/pi-bluetooth_0
			build raspberrypi/rpi-utils
		;;
		*)
			build lfs/kernel
			build lfs/GRUB
		;;
	esac
	build lfs/kmod
	build lfs/dracut
	build firmwares/linux-firmware
	build firmwares/wireless-regdb
### Core Libraries
	#build lfs/glibc
	build lfs/tzdata
	build lfs/shadow
	build lfs/Linux-PAM
### Core services
	build lfs/systemd
	build lfs/D-Bus
	build lfs/polkit
### Swap and the clock of the boards without an RTC
	build lfs/zram-swap
	build lfs/fake-hwclock
### Minimal
	build lfs/bash
	build lfs/man-pages
	build lfs/man-db
	build lfs/python3
	build perl/XML-Parser
	build lfs/perl5
### Filesystem progs
	build lfs/e2fsprogs
	build lfs/btrfs-progs
	build lfs/dosfstools
	build lfs/fuse
	build lfs/attr
	build lfs/acl
### System Utilities
	build lfs/file
	build lfs/bc
	build lfs/sed
	build lfs/psmisc
	build lfs/grep
	build lfs/coreutils
	build lfs/diffutils
	build lfs/gawk
	build lfs/findutils
	build lfs/groff
	build lfs/less
	build lfs/kbd
	build lfs/tar
	build lfs/vim
	build lfs/procps-ng
	build lfs/util-linux
	build lfs/elfutils
	build lfs/usb-utils
	build lfs/pciutils
	build lfs/lsof
	build lfs/which
	build lfs/intltool
### Network Utilities
	build lfs/iana-etc
	build lfs/inetutils
	build lfs/net-tools
	build lfs/iproute2
	build lfs/curl
	build lfs/wget2
	build lfs/tcpdump
### Wireless
	build lfs/wpa_supplicant
	build lfs/hostapd
	build lfs/iw
	#build lfs/wireless-tools
	build lfs/bluez
	if [ ${LFS_ENABLENM} -eq 1 ]
	then
		build lfs/NetworkManager
	fi
### Security
	build lfs/sudo
### Network Servers/Clients
	build lfs/bind9
	### ISC DHCP is end of life (2022) and nothing uses it: systemd-networkd and NetworkManager
	### have their own DHCP client, networkd a DHCP server too
	#build lfs/dhcp
	#build lfs/dhcpcd
	build lfs/openssh
	build lfs/Avahi
	build lfs/nss-mdns
### X11
	build lfs/xorg-server
	build lfs/xf86-input-libinput
	build lfs/xf86-input-evdev
	build lfs/xf86-video-fbdev
	build lfs/xinit
	build lfs/Mesa
	build lfs/OpenCL-ICD-Loader
	build lfs/mesa-demos
	build lfs/Xwayland
	build lfs/encodings
	build lfs/font-alias
	build lfs/font-adobe-utopia-type1
	build lfs/font-bh-ttf
	build lfs/font-bh-type1
	build lfs/font-ibm-type1
	build lfs/font-misc-ethiopic
	build lfs/font-xfree86-type1
	build lfs/liberation-fonts-ttf
	build lfs/liberation-narrow-fonts-ttf
### Gnome
	build lfs/Cairo
	### The SVG loader of gdk-pixbuf: it links librsvg, which Cairo builds
	build lfs/glycin:svg
### Multimediabbbb
	build lfs/alsa-utils
### Development
	build lfs/strace
	if [ ${LFS_ENABLEDEV} -eq 1 ]
	then
		build lfs/binutils
		build lfs/gcc:binaries
		build lfs/llvm
		build lfs/gdb
		build lfs/make
		build lfs/bison
		build lfs/flex
		build lfs/libtool
		build lfs/autoconf
		build lfs/automake
		build lfs/gettext
		build lfs/pkgconf
		build lfs/sccache
		build lfs/cmake
		build lfs/ninja
		build lfs/meson
		build lfs/doxygen
		build lfs/git
	else
		LFS_REMOVE_DEVFILES="--remove_devfiles"
	fi

### Instantiate post_build variables ###
source "${STATUS_PATH}/system_config"
########################################

### The configuration of the system being built: osconfig.functions writes the files into the
### sysroot and the commands that have to run inside the target into its post install script
set_hostname ${LFS_HOSTNAME}
set_locale en_US.UTF-8

if [ ${LFS_ENABLENM} -eq 1 ]
then
	### NetworkManager: DNS stays with systemd-resolved, the wired link gets the automatic DHCP
	### connection of NetworkManager (LFS_LANDEV is not needed), the WiFi network a keyfile profile
	configure_networkmanager --dns systemd-resolved
	if [ -n "${LFS_WLANSSID}" ] && [ -n "${LFS_WLANPSK}" ] && [ -n "${LFS_WLANDEV}" ]
	then
		### The passphrase goes through the pipe, never on a command line: the profile gets the key
		### wpa_passphrase derives from it and nothing else
		printf '%s\n' "${LFS_WLANPSK}" | configure_wireless ${LFS_WLANDEV} --networkmanager \
			--ssid "${LFS_WLANSSID}" ${LFS_WLANCOUNTRY:+--country ${LFS_WLANCOUNTRY}}
	fi
	set_service_preset enable NetworkManager.service NetworkManager-wait-online.service
	set_service_preset disable systemd-networkd.service systemd-networkd-wait-online.service
else
	if [ -n "${LFS_LANDEV}" ]
	then
		configure_network ${LFS_LANDEV}
	fi

	if [ -n "${LFS_WLANSSID}" ] && [ -n "${LFS_WLANPSK}" ] && [ -n "${LFS_WLANDEV}" ]
	then
		### The passphrase goes through the pipe, never on a command line: the image gets the key
		### wpa_passphrase derives from it and nothing else
		printf '%s\n' "${LFS_WLANPSK}" | configure_wireless ${LFS_WLANDEV} --ssid "${LFS_WLANSSID}" \
			${LFS_WLANCOUNTRY:+--country ${LFS_WLANCOUNTRY}}
		configure_network ${LFS_WLANDEV}
	fi

	### One link online is enough for network-online.target, which update-pki.service wants
	set_network_wait_online --any
fi

if [ ${LFS_ENABLESSH} -eq 1 ]
then
	configure_ssh
fi

### The policy of the project on the units of the packages: preset-all of a system installed
### from the packages follows it, the enable_service of the image states it here and now
set_service_preset enable fstrim.timer fake-hwclock.service fake-hwclock-save.timer
if [ ${LFS_ZRAM} -eq 1 ]
then
	set_service_preset enable zram-swap.service
fi

function build_lfs_image () {
	set -e
	create_image lfs --rootfstype ${LFS_FSTYPE} --size ${LFS_FSSIZE}
	mount_tag lfs --mountlist "2:/ 1:/boot"

	### Boot configuration and support scripts
	echo
	echo -n "Configuring boot parameters... "
	LFS_LBROOT="$(findmnt -nu -o SOURCE ${DATA_PATH}/${PROJECT_NAME}/${PLATFORM_NAME}/lfs)"
	LFS_PARTUUID="$(blkid -o value --match-tag PARTUUID ${LFS_LBROOT})"
	KERNEL_BOOTPARAMS="root=PARTUUID=${LFS_PARTUUID} rootfstype=${LFS_FSTYPE} fsck.repair=yes rootwait cgroup_enable=memory net.ifnames=0 systemd.gpt_auto=no"
	INITRAMFS_NAME=initramfs-${KERNEL_RELEASE}.img
	case ${PLATFORM_NAME} in
		rpi*)
			case ${PLATFORM_NAME} in
				rpi5-aarch64)
					echo "arm_64bit=1" >${BIN_PATH}/boot/config.txt
					echo "dtoverlay=vc4-kms-v3d-pi5" >>${BIN_PATH}/boot/config.txt
				;;
				rpi4-aarch64)
					echo "arm_64bit=1" >${BIN_PATH}/boot/config.txt
					echo "dtoverlay=vc4-kms-v3d-pi4" >>${BIN_PATH}/boot/config.txt
				;;
				rpi3-aarch64)
					echo "arm_64bit=1" >${BIN_PATH}/boot/config.txt
					echo "dtoverlay=vc4-kms-v3d" >>${BIN_PATH}/boot/config.txt
				;;
				*)
					echo "arm_64bit=0" >${BIN_PATH}/boot/config.txt
					echo "dtoverlay=vc4-kms-v3d" >>${BIN_PATH}/boot/config.txt
				;;
			esac
			### KERNEL_NAME of a platform carries ${KERNEL_VER} unexpanded, the way kernelbuild reads it
			### when it names the image: one more expansion gives the file the firmware has to find,
			### where "${KERNEL_NAME}-${KERNEL_VER}" wrote the version twice and the variable once
			cat >>${BIN_PATH}/boot/config.txt <<-EOF
				kernel $(eval echo "${KERNEL_NAME}")
				initramfs ${INITRAMFS_NAME} followkernel
			EOF
			cat >${BIN_PATH}/boot/cmdline.txt <<-EOF
				console=serial0,115200 console=tty1 ${KERNEL_BOOTPARAMS}
			EOF
		;;
		generic-x64)
			### The boot loader is installed on the disk of the image from inside it, with the
			### other post install commands of the project
			#add_postinstall_command "grub-install --target=x86_64-efi --removable --efi-directory=/boot --boot-directory=/boot"
			add_postinstall_command "grub-install ${LFS_LBROOT/p2/}"
			mkdir -p ${BIN_PATH}/boot/grub
			cat > ${BIN_PATH}/boot/grub/grub.cfg <<-EOF
				# Begin /boot/grub/grub.cfg
				set default=0
				set timeout=5

				insmod part_gpt
				insmod ${LFS_FSTYPE}
				set root=(hd0,1)

				if loadfont /boot/grub/fonts/unicode.pf2; then
				   set gfxmode=auto
				   insmod all_video
				   terminal_output gfxterm
				fi

				menuentry "GNU/Linux, Linux ${KERNEL_VER}"  {
				   linux /vmlinuz-${KERNEL_VER} ${KERNEL_BOOTPARAMS} ro
				   initrd /${INITRAMFS_NAME}
				}

				menuentry "GNU/Linux, Linux ${KERNEL_VER} - Serial output"  {
				   linux /vmlinuz-${KERNEL_VER} ${KERNEL_BOOTPARAMS} ro console=ttyS0
				   initrd /${INITRAMFS_NAME}
				}
			EOF
			ln -fs ../boot/grub/grub.cfg ${BIN_PATH}/etc/grub.cfg
		;;
	esac
	echo "Done."

	inject_into_mount_tag lfs binaries ${LFS_REMOVE_DEVFILES}
	run_postinstall_scripts lfs
	run_cmd "cp -fv ${PLATFORM_PATH}/lfs/boot/${INITRAMFS_NAME} ${BIN_PATH}/boot" >>${LOG_PATH}/images_lfs.log

	### The image is built and its post install scripts have run: --tag lfs is what makes these
	### run now, in the chroot of the image, instead of going into the post install script
	#enable_service --tag lfs console-getty
	set_default_target --tag lfs multi-user.target
	if [ ${LFS_ENABLENM} -eq 1 ]
	then
		### NetworkManager-wait-online is what network-online.target waits for; wpa_supplicant is
		### started by NetworkManager over D-Bus, hostapd stays disabled (an access point would be
		### a hotspot profile of NetworkManager)
		enable_service --tag lfs NetworkManager NetworkManager-wait-online
		disable_service --tag lfs systemd-networkd systemd-networkd-wait-online
	else
		enable_service --tag lfs systemd-networkd
	fi
	enable_service --tag lfs systemd-resolved systemd-timesyncd
	### fstrim.timer is the weekly TRIM of the flash storage, fake-hwclock the clock of the
	### boards without an RTC, zram-swap the compressed swap (LFS_ZRAM=0 leaves it out)
	enable_service --tag lfs fstrim.timer fake-hwclock.service fake-hwclock-save.timer
	if [ ${LFS_ZRAM} -eq 1 ]
	then
		enable_service --tag lfs zram-swap.service
	fi
	mask_service --tag lfs tmp.mount
	### video and audio are what the devices of the firmware mailbox (the udev rule of rpi-utils)
	### and the sound cards belong to: without them vcgencmd and aplay need root
	add_user lfs --tag lfs --groups wheel,audio,video --password lfs
	#set_password --tag lfs root changeme

	unmount_tag --finalize lfs
	if [ -n "${QEMU_MACHINE}" ] && [ -n "${QEMU_STORAGE}" ]
	then
		### qemu_cmdgen applies the overlays of QEMU_DTBO with fdtoverlay
		if [ -n "${QEMU_DTBO}" ]
		then
			build lfs/dtc:native
		fi
		utilities/qemu_cmdgen --quiet --batchtype all \
			--rootdev PARTUUID=${LFS_PARTUUID} --rootfs ${LFS_FSTYPE} \
			--savecmd ${DATA_PATH}/${PROJECT_NAME}/${PLATFORM_NAME}/${PROJECT_NAME}.qemu \
			${PROJECT_NAME} ${PLATFORM_NAME}
	fi
	set +e
}

case ${LFS_IMAGE} in
	0|disabled) ;;
	*) build_lfs_image
esac

#create_sfx_archive remove_devfiles
#zip_project remove_devfiles